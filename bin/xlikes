#!/bin/sh
# Run xlikes without activating the virtualenv first.
#
# Uses the repo's .venv if it exists, otherwise whatever python3 is on PATH —
# searching needs nothing beyond the standard library, so the bare interpreter
# is usually fine (only `fetch` and `user` need playwright). Works from any
# directory, and works when symlinked onto your PATH:
#     sudo ln -s "$PWD/bin/xlikes" /usr/local/bin/xlikes
#
# $0 is the symlink when invoked through one, so follow the chain to find the
# repo; taking dirname of $0 directly would point at /usr/local/bin.
target=$0
while [ -L "$target" ]; do
    link=$(readlink "$target")
    case $link in
        /*) target=$link ;;
        *)  target=$(dirname -- "$target")/$link ;;
    esac
done
here=$(CDPATH= cd -- "$(dirname -- "$target")/.." && pwd)

if [ -x "$here/.venv/bin/python" ]; then
    exec "$here/.venv/bin/python" -m xlikes.cli "$@"
fi
PYTHONPATH="$here${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m xlikes.cli "$@"
